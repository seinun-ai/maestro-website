# The canonical origin for the deployed site.
#
# metadataBase, every canonical URL, the Open Graph tags, sitemap.xml and
# robots.txt all derive from this at BUILD time. Set it in your host's
# environment variables before the production build, or LinkedIn and X will
# render a broken preview card from the fallback origin.
NEXT_PUBLIC_SITE_URL=https://maestrocareerstudio.com
